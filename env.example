JEV_API_KEY=xxx
OPENAI_API_KEY=sk-proj--xxx
GOOGLE_PLACES_API_KEY=xxx

# Google Business Profile OAuth (roadmap 003). Redirect URI must match the OAuth client in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=xxx
GOOGLE_OAUTH_CLIENT_SECRET=xxx
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/google/callback
# Fernet key that encrypts stored Google tokens. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=xxx

# Deploy (docker-compose.yml): deploy/bootstrap.sh appends DOMAIN, DJANGO_SECRET_KEY and POSTGRES_PASSWORD.
# COMPANYSCAN_SERVICE_NAME=Obvious Choice Systems
# COMPANYSCAN_LOG_LEVEL=INFO
